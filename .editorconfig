root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,ts,tsx,js,jsx,css,html,md}]
indent_size = 2

# EF Core migrations are generated code; don't hold them to analyzer rules.
[**/Migrations/*.cs]
generated_code = true
